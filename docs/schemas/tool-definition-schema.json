{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tool-definition-schema.json",
  "title": "ToolDefinition",
  "description": "Schema for the Discovery Tool DefinitionContent payload (VersionNeutral/ToolDefinition.cs). Validated by ToolDefinitionContentValidator.",
  "type": "object",
  "required": ["name", "description", "version", "category", "infra"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,126}[A-Za-z0-9]$",
      "description": "Unique name of the tool."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Human-readable description of the tool."
    },
    "version": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/semanticVersion" }],
      "description": "Version of the tool definition (e.g. '1.0.0')."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Category used to group and discover the tool."
    },
    "license": {
      "type": "string",
      "maxLength": 512,
      "description": "Optional SPDX license identifier or license text."
    },
    "infra": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "description": "One or more infrastructure definitions that back the tool's actions.",
      "items": {
        "$ref": "#/$defs/InfraDefinition"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 128,
      "description": "Tool actions that can be invoked by Discovery.",
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolAction"
      }
    },
    "code_environments": {
      "type": "array",
      "maxItems": 32,
      "description": "Code execution environments available for this tool.",
      "default": [],
      "items": {
        "$ref": "#/$defs/CodeEnvironment"
      }
    }
  },
  "$defs": {
    "InfraDefinition": {
      "title": "InfraDefinition",
      "description": "Describes a single infrastructure node (container + compute) that powers one or more actions.",
      "type": "object",
      "required": ["name", "infra_type", "image", "compute"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "description": "Logical name for this infra node; referenced by actions via infra_node."
        },
        "infra_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "Infrastructure type identifier (e.g. 'container')."
        },
        "image": {
          "$ref": "#/$defs/ImageConfig"
        },
        "compute": {
          "$ref": "#/$defs/ComputeConfig"
        }
      }
    },
    "ImageConfig": {
      "title": "ImageConfig",
      "description": "Container image configuration for an infrastructure node.",
      "type": "object",
      "required": ["acr"],
      "additionalProperties": false,
      "properties": {
        "acr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\{name\\}\\.azurecr\\.io/[A-Za-z0-9][A-Za-z0-9._/-]{0,382}(?::[A-Za-z0-9][A-Za-z0-9._-]{0,127})?$",
          "description": "Azure Container Registry image reference using the deployer-substituted registry placeholder (e.g. '{name}.azurecr.io/myimage:latest'). Do not hardcode a registry name."
        }
      }
    },
    "ComputeConfig": {
      "title": "ComputeConfig",
      "description": "Compute resource requirements and scaling configuration for an infrastructure node.",
      "type": "object",
      "required": ["min_resources", "max_resources"],
      "additionalProperties": false,
      "properties": {
        "min_resources": {
          "$ref": "#/$defs/VmSku",
          "description": "Minimum compute resources required."
        },
        "max_resources": {
          "$ref": "#/$defs/VmSku",
          "description": "Maximum compute resources allowed."
        },
        "infiniband": {
          "type": "boolean",
          "description": "Whether InfiniBand networking is required."
        },
        "recommended_sku": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "description": "Ordered list of recommended Azure VM SKU names (e.g. 'Standard_NC24ads_A100_v4').",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "pool_type": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "Pool type for the compute node (snake_case variant)."
        },
        "poolType": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "Pool type for the compute node (camelCase variant; use either pool_type or poolType)."
        },
        "pool_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Number of nodes in the pool (snake_case variant)."
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Number of nodes in the pool (camelCase variant; use either pool_size or poolSize)."
        }
      }
    },
    "VmSku": {
      "title": "VmSku",
      "description": "Resource specification for a compute node. Numeric fields accept both integer (4) and string ('4') values.",
      "type": "object",
      "required": ["cpu", "ram"],
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 3, "pattern": "^[1-9][0-9]{0,2}$" },
            { "type": "integer", "minimum": 1, "maximum": 4096 }
          ],
          "description": "Number of vCPUs."
        },
        "ram": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[1-9][0-9]{0,5}(?:Mi|Gi)?$" },
            { "type": "integer", "minimum": 1, "maximum": 1048576 }
          ],
          "description": "RAM in GB."
        },
        "storage": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 9, "pattern": "^(?:0|[1-9][0-9]{0,6})(?:Mi|Gi)?$" },
            { "type": "integer", "minimum": 0, "maximum": 10485760 }
          ],
          "description": "Ephemeral storage in GB (optional)."
        },
        "gpu": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 3, "pattern": "^(?:0|[1-9][0-9]{0,2})$" },
            { "type": "integer", "minimum": 0, "maximum": 4096 }
          ],
          "description": "Number of GPUs (optional)."
        }
      }
    },
    "ToolAction": {
      "title": "ToolAction",
      "description": "A discrete, invocable action exposed by this tool.",
      "type": "object",
      "required": ["name", "description", "infra_node", "input_schema", "command"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "description": "Unique action name within this tool."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Human-readable description of what this action does."
        },
        "infra_node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "description": "Reference to an infra[].name entry that runs this action."
        },
        "input_schema": {
          "$ref": "#/$defs/ToolInputSchema"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Entrypoint command executed inside the container for this action."
        },
        "environment_variables": {
          "type": "array",
          "maxItems": 64,
          "description": "Static environment variables injected into the container.",
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolEnvironmentVariable"
          }
        },
        "inline_files": {
          "type": "array",
          "maxItems": 32,
          "description": "Files written into the container at the specified mount paths before execution.",
          "default": [],
          "items": {
            "$ref": "#/$defs/InlineFile"
          }
        },
        "output_mount_configurations": {
          "type": "array",
          "maxItems": 32,
          "description": "Container paths that produce output assets after action execution.",
          "default": [],
          "items": {
            "$ref": "#/$defs/OutputMountConfiguration"
          }
        }
      }
    },
    "ToolInputSchema": {
      "title": "ToolInputSchema",
      "description": "JSON-Schema-style definition of the inputs accepted by a tool action.",
      "type": "object",
      "required": ["type", "required"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "object",
          "description": "JSON Schema type (typically 'object')."
        },
        "properties": {
          "type": "object",
          "description": "Map of parameter names to bounded JSON Schema definitions.",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": { "$ref": "#/$defs/ParameterSchema" },
          "default": {}
        },
        "required": {
          "type": "array",
          "description": "List of property names that are required when invoking this action.",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "ParameterSchema": {
      "title": "ParameterSchema",
      "description": "Bounded JSON Schema keywords accepted for one tool input parameter.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean"]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "enum": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "type": "string", "maxLength": 1024 },
              { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
              { "type": "boolean" }
            ]
          }
        },
        "minimum": {
          "type": "number",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "maximum": {
          "type": "number",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "pattern": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "ToolEnvironmentVariable": {
      "title": "ToolEnvironmentVariable",
      "description": "A static environment variable injected into the container at runtime.",
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "description": "Environment variable name."
        },
        "value": {
          "type": "string",
          "maxLength": 8192,
          "description": "Environment variable value."
        }
      }
    },
    "InlineFile": {
      "title": "InlineFile",
      "description": "A file written into the container at a specified path before action execution.",
      "type": "object",
      "required": ["mount_path", "content"],
      "additionalProperties": false,
      "properties": {
        "mount_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "description": "Absolute path inside the container where the file is written."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "description": "Raw file content."
        }
      }
    },
    "OutputMountConfiguration": {
      "title": "OutputMountConfiguration",
      "description": "Configures a container path that produces an output asset after action execution.",
      "type": "object",
      "required": ["mount_path", "auto_promote", "output_name", "output_description"],
      "additionalProperties": false,
      "properties": {
        "mount_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "description": "Absolute container path that will contain the output after execution."
        },
        "auto_promote": {
          "type": "boolean",
          "description": "When true, the output is automatically promoted to a Discovery data asset."
        },
        "output_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Name of the resulting output asset."
        },
        "output_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Description of the resulting output asset."
        }
      }
    },
    "CodeEnvironment": {
      "title": "CodeEnvironment",
      "description": "A language runtime environment available for interactive or notebook-style execution.",
      "type": "object",
      "required": ["language", "command", "description", "infra_node"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_+.-]{0,31}$",
          "description": "Programming language identifier (e.g. 'python', 'r')."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Entrypoint command that starts the code execution environment."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Human-readable description of this code environment."
        },
        "infra_node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "description": "Reference to an infra[].name entry that hosts this environment."
        }
      }
    }
  }
}
