{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "starter-kit-schema.json",
  "title": "Discovery Catalog Starter Kit Manifest",
  "description": "Schema for starter-kits/<name>/kit.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "keywords", "category", "lifecycle", "displayName", "longDescription", "agentRefs"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "maxLength": 2048,
      "description": "JSON Schema reference URI."
    },
    "name": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/kebabCaseString" }],
      "maxLength": 64,
      "description": "Kebab-case identifier. Must equal the parent directory name."
    },
    "version": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/semanticVersion" }],
      "description": "Semantic version, e.g. 1.0.0. Bump on meaningful content changes."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One-line description. Shown in CLI browse output."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email": { "$ref": "common-schema.json#/definitions/emailAddress" },
        "url": { "$ref": "common-schema.json#/definitions/httpsUrl" }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SPDX identifier, e.g. MIT."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9](?:[a-z0-9 +./-]{0,62}[a-z0-9])?$"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Lowercase search/filter terms."
    },
    "category": {
      "type": "string",
      "enum": ["Biology", "Chemistry", "Physics", "Silicon", "Quantum", "Materials", "Neuroscience"],
      "description": "Primary display category."
    },
    "homepage": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/httpsUrl" }],
      "description": "URL for more information."
    },
    "repository": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/httpsUrl" }],
      "description": "Source repository URL."
    },
    "party": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/party" }],
      "description": "Optional. '1p' = Microsoft first-party authored; '3p' = third-party / partner. Used to drive the 1p-contribution / 3p-contribution PR labels; not validated against folder path."
    },
    "lifecycle": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/lifecycle" }],
      "description": "Authored lifecycle state. Never set to 'degraded' (that is computed)."
    },
    "featureFlag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "description": "If set, kit is only surfaced in Discovery UI when this feature flag is enabled."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Card title shown in Discovery UI and CLI browse."
    },
    "longDescription": {
      "type": "string",
      "minLength": 50,
      "maxLength": 50000,
      "description": "Markdown body for the detail view."
    },
    "logo": {
      "allOf": [{ "$ref": "common-schema.json#/definitions/httpsUrl" }],
      "description": "HTTPS URL to the kit logo used by catalog-card metadata. Local images are permitted only as documentation assets referenced from Markdown."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "common-schema.json#/definitions/httpsUrl"
      },
      "description": "HTTPS URLs to screenshots used by catalog metadata. Local images are permitted only as documentation assets referenced from Markdown."
    },
    "websiteURL": {
      "$ref": "common-schema.json#/definitions/httpsUrl"
    },
    "privacyPolicyURL": {
      "$ref": "common-schema.json#/definitions/httpsUrl"
    },
    "agentRefs": {
      "type": "array",
      "items": { "$ref": "#/definitions/agentRef" },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "All agents used by this kit. Exactly one must have role:primary and required:true."
    },
    "samplePrompts": {
      "type": "array",
      "items": { "$ref": "#/definitions/samplePrompt" },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Rich UI prompts with difficulty and expected output. Required for lifecycle:active kits."
    },
    "riskProfile": {
      "$ref": "#/definitions/riskProfile"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "lifecycle": { "const": "active" } },
        "required": ["lifecycle"]
      },
      "then": {
        "required": ["samplePrompts"]
      }
    }
  ],
  "definitions": {
    "agentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role", "required"],
      "properties": {
        "ref": {
          "allOf": [{ "$ref": "common-schema.json#/definitions/agentPath" }],
          "description": "Relative path matching entries[].path in .auto-registry/agent-registry.json."
        },
        "role": {
          "allOf": [{ "$ref": "common-schema.json#/definitions/agentRole" }],
          "description": "primary: the launch agent for this kit. supporting: auxiliary agent."
        },
        "required": {
          "type": "boolean",
          "description": "If true, kit is degraded when this agent is absent from the registry."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable description of this agent's role in the kit."
        }
      }
    },
    "samplePrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prompt"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^sp-[a-z0-9](?:[a-z0-9-]{0,59}[a-z0-9])?$",
          "description": "Stable identifier for this prompt, e.g. sp-1."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Full prompt text shown in the Discovery UI 'Try it' tile."
        },
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "expectedOutput": {
          "type": "string",
          "maxLength": 1000,
          "description": "Description of what the user should expect as output."
        }
      }
    },
    "riskProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Trust and compliance information surfaced as UI chips.",
      "properties": {
        "requiresExternalCompute": {
          "type": "boolean",
          "description": "Whether any agent calls an external compute service."
        },
        "dataResidency": {
          "type": "string",
          "maxLength": 500,
          "description": "Freeform description of data residency. E.g. 'user-managed Azure subscription'."
        }
      }
    }
  }
}

