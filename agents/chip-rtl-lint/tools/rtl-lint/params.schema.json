{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTL lint worker parameters at /input/params.json",
  "type": "object",
  "required": ["scenario"],
  "properties": {
    "scenario": {"enum": ["lint_gate", "lint", "format"]},
    "source": {"type": "string", "pattern": "^/input/"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/input/"}},
    "ruleset": {"type": "string", "default": "default"},
    "rules": {"type": "array", "items": {"type": "string"}},
    "rules_config": {"type": "string", "pattern": "^/input/"},
    "rules_config_search": {"type": "boolean", "default": false},
    "waiver_files": {"type": "array", "items": {"type": "string", "pattern": "^/input/"}},
    "format_gating": {"type": "boolean", "default": true},
    "column_limit": {"type": "integer", "minimum": 1, "default": 100},
    "indentation_spaces": {"type": "integer", "minimum": 1, "default": 2},
    "write_formatted": {"type": "boolean", "default": false},
    "autofix": {"enum": ["no", "patch", "generate-waiver"]},
    "autofix_output_file": {"type": "string", "pattern": "^/output/"}
  },
  "oneOf": [
    {"required": ["source"], "not": {"required": ["sources"]}},
    {"required": ["sources"], "not": {"required": ["source"]}}
  ],
  "additionalProperties": true
}
