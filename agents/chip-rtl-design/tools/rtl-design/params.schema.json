{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTL design worker parameters at /input/params.json",
  "type": "object",
  "required": ["scenario", "top"],
  "properties": {
    "scenario": {"enum": ["check_authored", "lint_hygiene", "elaborate", "cdc_scan"]},
    "top": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "rtl": {"type": "string", "minLength": 1},
    "rtl_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/input/"}},
    "include_dirs": {"type": "array", "items": {"type": "string", "pattern": "^/input/"}},
    "defines": {"type": "object"}
  },
  "oneOf": [
    {"required": ["rtl"], "not": {"required": ["rtl_files"]}},
    {"required": ["rtl_files"], "not": {"required": ["rtl"]}}
  ],
  "additionalProperties": true
}
