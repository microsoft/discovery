{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowblind.local/schemas/flowblind-catalog-hidden-flow-problem-acceptance-v1.schema.json",
  "title": "FlowBlind catalog hidden-flow accepted problem v1",
  "description": "Package-specific machine-readable projection of parseHiddenFlowProblem limits. The generic draft-07 problem schema remains a syntactic prefilter only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "domain",
    "basis",
    "observations",
    "budgets",
    "target",
    "numerics",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "title": { "$ref": "#/$defs/title" },
    "description": { "$ref": "#/$defs/text" },
    "domain": { "$ref": "#/$defs/domain" },
    "basis": { "$ref": "#/$defs/basis" },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/observation" }
    },
    "budgets": { "$ref": "#/$defs/budgets" },
    "target": { "$ref": "#/$defs/target" },
    "numerics": { "$ref": "#/$defs/numerics" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "finiteNumber": {
      "type": "number",
      "minimum": -1e100,
      "maximum": 1e100
    },
    "nonnegative": {
      "allOf": [
        { "$ref": "#/$defs/finiteNumber" },
        { "minimum": 0 }
      ]
    },
    "positive": {
      "allOf": [
        { "$ref": "#/$defs/finiteNumber" },
        { "exclusiveMinimum": 0 }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coordinateFrameId",
        "lengthUnit",
        "xEdges",
        "yEdges",
        "validCellMask"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "coordinateFrameId": { "$ref": "#/$defs/identifier" },
        "lengthUnit": { "const": "mm" },
        "xEdges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 65,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "yEdges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 65,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "validCellMask": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "contains": { "const": true },
          "items": { "type": "boolean" }
        }
      }
    },
    "basisCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "point"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "point": { "$ref": "#/$defs/point" }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "degree",
        "spacingX",
        "spacingY",
        "streamfunctionLengthScale",
        "interiorMarginCells",
        "quadratureOrder",
        "coefficientUnit",
        "boundaryPolicy",
        "centers"
      ],
      "properties": {
        "family": {
          "const": "tensor-cardinal-cubic-streamfunction-v1"
        },
        "degree": { "const": 3 },
        "spacingX": { "$ref": "#/$defs/positive" },
        "spacingY": { "$ref": "#/$defs/positive" },
        "streamfunctionLengthScale": {
          "$ref": "#/$defs/positive"
        },
        "interiorMarginCells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "quadratureOrder": { "const": 4 },
        "coefficientUnit": { "const": "mm/s" },
        "boundaryPolicy": {
          "const": "compact-support-inside-valid-cell-union"
        },
        "centers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": { "$ref": "#/$defs/basisCenter" }
        }
      }
    },
    "observationBase": {
      "type": "object",
      "required": [
        "type",
        "id",
        "sensorId",
        "point",
        "coordinateFrameId",
        "unit",
        "baselineValue",
        "observedValue",
        "tolerance",
        "provenance"
      ],
      "properties": {
        "type": { "type": "string" },
        "id": { "$ref": "#/$defs/identifier" },
        "sensorId": { "$ref": "#/$defs/identifier" },
        "point": { "$ref": "#/$defs/point" },
        "coordinateFrameId": { "$ref": "#/$defs/identifier" },
        "unit": { "const": "mm/s" },
        "baselineValue": { "$ref": "#/$defs/finiteNumber" },
        "observedValue": { "$ref": "#/$defs/finiteNumber" },
        "tolerance": { "$ref": "#/$defs/nonnegative" },
        "provenance": { "$ref": "#/$defs/text" }
      }
    },
    "observation": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/observationBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["component"],
              "properties": {
                "type": { "const": "point-component" },
                "id": true,
                "sensorId": true,
                "point": true,
                "coordinateFrameId": true,
                "unit": true,
                "component": { "enum": ["x", "y"] },
                "baselineValue": true,
                "observedValue": true,
                "tolerance": true,
                "provenance": true
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/observationBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["direction"],
              "properties": {
                "type": { "const": "point-direction" },
                "id": true,
                "sensorId": true,
                "point": true,
                "coordinateFrameId": true,
                "unit": true,
                "direction": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/finiteNumber" }
                },
                "baselineValue": true,
                "observedValue": true,
                "tolerance": true,
                "provenance": true
              }
            }
          ]
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "$ref": "#/$defs/nonnegative" },
        "unit": { "enum": ["mm/s", "1/s"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["velocityRms", "velocityGradientRms"],
      "properties": {
        "velocityRms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/budget" }
          ]
        },
        "velocityGradientRms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/budget" }
          ]
        }
      }
    },
    "targetBase": {
      "type": "object",
      "required": ["type", "id", "title"],
      "properties": {
        "type": { "type": "string" },
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" }
      }
    },
    "target": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/targetBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "component", "unit"],
              "properties": {
                "type": { "const": "point-component" },
                "id": true,
                "title": true,
                "point": { "$ref": "#/$defs/point" },
                "component": { "enum": ["x", "y"] },
                "unit": { "const": "mm/s" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/targetBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "direction", "unit"],
              "properties": {
                "type": { "const": "point-direction" },
                "id": true,
                "title": true,
                "point": { "$ref": "#/$defs/point" },
                "direction": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/finiteNumber" }
                },
                "unit": { "const": "mm/s" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/targetBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "unit", "directionCount"],
              "properties": {
                "type": { "const": "point-speed-envelope" },
                "id": true,
                "title": true,
                "point": { "$ref": "#/$defs/point" },
                "unit": { "const": "mm/s" },
                "directionCount": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 64
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/targetBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["cellIndices", "component", "unit"],
              "properties": {
                "type": { "const": "region-component" },
                "id": true,
                "title": true,
                "cellIndices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1024,
                  "items": { "type": "integer", "minimum": 0 }
                },
                "component": { "enum": ["x", "y"] },
                "unit": { "const": "mm/s" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/targetBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "component", "unit"],
              "properties": {
                "type": { "const": "point-strain-component" },
                "id": true,
                "title": true,
                "point": { "$ref": "#/$defs/point" },
                "component": { "enum": ["xx", "yy", "xy"] },
                "unit": { "const": "1/s" }
              }
            }
          ]
        }
      ]
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rankRelativeTolerance",
        "basisConditionLimit",
        "verificationAbsoluteTolerance",
        "verificationRelativeTolerance",
        "maximumSolverIterations"
      ],
      "properties": {
        "rankRelativeTolerance": { "$ref": "#/$defs/positive" },
        "basisConditionLimit": { "$ref": "#/$defs/positive" },
        "verificationAbsoluteTolerance": {
          "$ref": "#/$defs/positive"
        },
        "verificationRelativeTolerance": {
          "$ref": "#/$defs/positive"
        },
        "maximumSolverIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "citation", "license", "transformations"],
      "properties": {
        "sourceKind": { "enum": ["generated", "declared"] },
        "citation": { "$ref": "#/$defs/text" },
        "license": { "$ref": "#/$defs/title" },
        "transformations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
