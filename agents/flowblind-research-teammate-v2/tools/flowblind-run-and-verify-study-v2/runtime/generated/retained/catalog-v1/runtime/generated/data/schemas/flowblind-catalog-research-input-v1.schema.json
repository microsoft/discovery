{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowblind.local/schemas/flowblind-catalog-research-input-v1.schema.json",
  "title": "FlowBlind catalog research action input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["researchGoal"],
  "properties": {
    "researchGoal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "decisionQuestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "nextEvidenceIntent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
