{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowblind.local/schemas/flowblind-catalog-action-response-v1.schema.json",
  "title": "FlowBlind catalog action response v1",
  "oneOf": [
    { "$ref": "#/$defs/preparationSuccess" },
    { "$ref": "#/$defs/runSuccess" },
    {
      "$ref": "flowblind-catalog-vector-action-success-v1.schema.json"
    },
    { "$ref": "#/$defs/refusal" },
    { "$ref": "#/$defs/intentOutcome" }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceIdentity": {
      "$ref": "flowblind-catalog-preparation-bundle-v1.schema.json#/$defs/identity"
    },
    "jsonArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "byteLength", "sha256", "mediaType"],
      "properties": {
        "reference": { "$ref": "#/$defs/text" },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "const": "application/json" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "byteLength", "sha256", "mediaType"],
      "properties": {
        "reference": { "$ref": "#/$defs/text" },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": {
          "enum": [
            "application/json",
            "text/markdown",
            "text/html"
          ]
        }
      }
    },
    "preparationSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "teammateVersion",
        "status",
        "containsResults",
        "humanContext",
        "sourceIdentity",
        "sidecarIdentity",
        "declarationPreview",
        "structure",
        "windowSupport",
        "matchedCapability",
        "preparationAsset",
        "preparationBundle"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "teammateVersion": { "const": "1.0.0" },
        "status": { "const": "prepared-awaiting-confirmation" },
        "containsResults": { "const": false },
        "humanContext": {
          "$ref": "flowblind-catalog-research-input-v1.schema.json"
        },
        "sourceIdentity": { "$ref": "#/$defs/sourceIdentity" },
        "sidecarIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "byteLength",
            "sha256",
            "mediaType",
            "schemaId"
          ],
          "properties": {
            "reference": { "$ref": "#/$defs/text" },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "mediaType": { "const": "application/json" },
            "schemaId": {
              "enum": [
                "https://flowblind.local/schemas/flowblind-trusted-source-sidecar-v2.schema.json",
                "https://flowblind.local/schemas/flowblind-catalog-vector-source-sidecar-v1.schema.json"
              ]
            }
          }
        },
        "declarationPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewStatus",
            "unverifiedScientistAssertions",
            "validatedV1Projection"
          ],
          "properties": {
            "reviewStatus": {
              "const": "requires-scientist-review-before-run"
            },
            "unverifiedScientistAssertions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity",
                "referenceMeaning",
                "candidateMeaning",
                "coordinateUnit",
                "valueUnit",
                "provenance",
                "license"
              ],
              "properties": {
                "quantity": { "$ref": "#/$defs/text" },
                "referenceMeaning": { "$ref": "#/$defs/text" },
                "candidateMeaning": { "$ref": "#/$defs/text" },
                "coordinateUnit": { "$ref": "#/$defs/text" },
                "valueUnit": { "$ref": "#/$defs/text" },
                "provenance": { "$ref": "#/$defs/text" },
                "license": { "$ref": "#/$defs/text" }
              }
            },
            "validatedV1Projection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceMeaning",
                "referenceRole",
                "candidateRole",
                "coordinateDimensions",
                "singleFrame",
                "pairedValues",
                "rows",
                "width",
                "height",
                "header",
                "temporalSampling"
              ],
              "properties": {
                "sourceMeaning": { "$ref": "#/$defs/text" },
                "referenceRole": { "const": "reference" },
                "candidateRole": { "const": "candidate" },
                "coordinateDimensions": { "const": 2 },
                "singleFrame": { "const": true },
                "pairedValues": { "const": true },
                "rows": {
                  "type": "integer",
                  "minimum": 270,
                  "maximum": 250000
                },
                "width": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 4096
                },
                "height": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 4096
                },
                "header": {
                  "const": [
                    "x",
                    "y",
                    "reference_value",
                    "candidate_value"
                  ]
                },
                "temporalSampling": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "frameCount",
                    "sampling",
                    "exposure"
                  ],
                  "properties": {
                    "frameCount": { "const": 1 },
                    "sampling": { "const": "single-frame" },
                    "exposure": { "const": "unspecified" }
                  }
                }
              }
            }
          }
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "width", "height"],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 270,
              "maximum": 250000
            },
            "width": {
              "type": "integer",
              "minimum": 3,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 3,
              "maximum": 4096
            }
          }
        },
        "windowSupport": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 30,
            "maximum": 1000000
          }
        },
        "matchedCapability": {
          "$ref": "flowblind-catalog-preparation-bundle-v1.schema.json#/$defs/capability"
        },
        "preparationAsset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "bundleSha256",
            "fileCount"
          ],
          "properties": {
            "reference": { "$ref": "#/$defs/text" },
            "bundleSha256": { "$ref": "#/$defs/sha256" },
            "fileCount": { "const": 2 }
          }
        },
        "preparationBundle": { "$ref": "#/$defs/jsonArtifact" }
      }
    },
    "runSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "teammateVersion",
        "status",
        "containsResults",
        "humanContext",
        "matchedCapability",
        "verifiedStudy",
        "preparationEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "teammateVersion": { "const": "1.0.0" },
        "status": { "const": "report-complete" },
        "containsResults": { "const": true },
        "humanContext": {
          "$ref": "flowblind-catalog-research-input-v1.schema.json"
        },
        "matchedCapability": {
          "$ref": "flowblind-catalog-preparation-bundle-v1.schema.json#/$defs/capability"
        },
        "verifiedStudy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "artifactVerificationStatus",
            "deterministicReplayMatched",
            "sourceIdentityMatched",
            "result",
            "artifacts",
            "openVisualReport"
          ],
          "properties": {
            "status": { "const": "verified" },
            "artifactVerificationStatus": { "const": "verified" },
            "deterministicReplayMatched": { "const": true },
            "sourceIdentityMatched": { "const": true },
            "result": {
              "$ref": "flowblind-catalog-verified-study-v1.schema.json#/$defs/scientificProjection"
            },
            "artifacts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["json", "markdown", "html", "verification"],
              "properties": {
                "json": { "$ref": "#/$defs/jsonArtifact" },
                "markdown": {
                  "allOf": [
                    { "$ref": "#/$defs/artifact" },
                    {
                      "properties": {
                        "mediaType": { "const": "text/markdown" }
                      }
                    }
                  ]
                },
                "html": {
                  "allOf": [
                    { "$ref": "#/$defs/artifact" },
                    {
                      "properties": {
                        "mediaType": { "const": "text/html" }
                      }
                    }
                  ]
                },
                "verification": { "$ref": "#/$defs/jsonArtifact" }
              }
            },
            "openVisualReport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "uri",
                "mediaType",
                "byteLength",
                "sha256"
              ],
              "properties": {
                "label": { "const": "Open visual report" },
                "uri": {
                  "type": "string",
                  "pattern": "^flowblind-report://sha256/[a-f0-9]{64}\\?verification=[a-f0-9]{64}&preparation=[a-f0-9]{64}$"
                },
                "mediaType": { "const": "text/html" },
                "byteLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16777216
                },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        },
        "preparationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "preparation",
            "source",
            "protocol",
            "software"
          ],
          "properties": {
            "kind": { "const": "portable-preparation-bundle-v1" },
            "preparation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "associationSha256", "bundle"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^flowblind-preparation-[a-f0-9]{32}$"
                },
                "associationSha256": { "$ref": "#/$defs/sha256" },
                "bundle": { "$ref": "#/$defs/jsonArtifact" }
              }
            },
            "source": {
              "$ref": "flowblind-catalog-verified-study-v1.schema.json#/$defs/sourceIdentities"
            },
            "protocol": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256"],
              "properties": {
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "software": {
              "$ref": "flowblind-catalog-preparation-bundle-v1.schema.json#/$defs/software"
            }
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "teammateVersion",
        "status",
        "error",
        "containsResults"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "teammateVersion": { "const": "1.0.0" },
        "status": { "const": "refused" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "classification", "detail"],
          "properties": {
            "code": {
              "enum": [
                "attachment-set-invalid",
                "attachment-path-unsafe",
                "attachment-changed-during-read",
                "source-not-fully-hydrated",
                "legacy-sidecar-not-trusted",
                "candidate-sidecar-mismatch",
                "sidecar-invalid",
                "source-structure-invalid",
                "capability-metadata-mismatch",
                "capability-preparation-mismatch",
                "preparation-bundle-invalid",
                "preparation-build-mismatch",
                "preparation-bundle-source-mismatch",
                "human-context-mismatch",
                "package-attestation-failed",
                "confirmation-required",
                "run-failed",
                "verification-failed",
                "source-identity-mismatch",
                "output-artifact-tampered",
                "output-publication-partial",
                "concurrent-publication-conflict",
                "operation-cancelled",
                "unsupported-action"
              ]
            },
            "classification": {
              "enum": [
                "cancellation",
                "confirmation",
                "execution",
                "input-validation",
                "package-attestation",
                "publication",
                "verification"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "containsResults": { "const": false }
      }
    },
    "intentOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "teammateVersion",
        "status",
        "reasonCodes",
        "guidance",
        "containsResults"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "teammateVersion": { "const": "1.0.0" },
        "status": {
          "enum": [
            "unsafe-unsupported",
            "needs-scientific-method",
            "unsupported",
            "ambiguous"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "guidance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "containsResults": { "const": false }
      }
    }
  }
}
