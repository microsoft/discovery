{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowblind.local/schemas/hidden-flow-problem.schema.json",
  "title": "FlowBlind hidden-flow problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "domain",
    "basis",
    "observations",
    "budgets",
    "target",
    "numerics",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/identifier" },
    "title": { "$ref": "#/definitions/title" },
    "description": { "$ref": "#/definitions/text" },
    "domain": { "$ref": "#/definitions/domain" },
    "basis": { "$ref": "#/definitions/basis" },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/definitions/observation" }
    },
    "budgets": { "$ref": "#/definitions/budgets" },
    "target": { "$ref": "#/definitions/target" },
    "numerics": { "$ref": "#/definitions/numerics" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/text" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "finiteNumber": { "type": "number" },
    "nonnegative": {
      "allOf": [
        { "$ref": "#/definitions/finiteNumber" },
        { "minimum": 0 }
      ]
    },
    "positive": {
      "allOf": [
        { "$ref": "#/definitions/finiteNumber" },
        { "exclusiveMinimum": 0 }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/definitions/finiteNumber" },
        "y": { "$ref": "#/definitions/finiteNumber" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coordinateFrameId",
        "lengthUnit",
        "xEdges",
        "yEdges",
        "validCellMask"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "coordinateFrameId": { "$ref": "#/definitions/identifier" },
        "lengthUnit": { "const": "mm" },
        "xEdges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 65,
          "items": { "$ref": "#/definitions/finiteNumber" }
        },
        "yEdges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 65,
          "items": { "$ref": "#/definitions/finiteNumber" }
        },
        "validCellMask": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "type": "boolean" }
        }
      }
    },
    "basisCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "point"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "point": { "$ref": "#/definitions/point" }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "degree",
        "spacingX",
        "spacingY",
        "streamfunctionLengthScale",
        "interiorMarginCells",
        "quadratureOrder",
        "coefficientUnit",
        "boundaryPolicy",
        "centers"
      ],
      "properties": {
        "family": {
          "const": "tensor-cardinal-cubic-streamfunction-v1"
        },
        "degree": { "const": 3 },
        "spacingX": { "$ref": "#/definitions/positive" },
        "spacingY": { "$ref": "#/definitions/positive" },
        "streamfunctionLengthScale": {
          "$ref": "#/definitions/positive"
        },
        "interiorMarginCells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "quadratureOrder": { "const": 4 },
        "coefficientUnit": { "const": "mm/s" },
        "boundaryPolicy": {
          "const": "compact-support-inside-valid-cell-union"
        },
        "centers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/definitions/basisCenter" }
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "sensorId",
            "point",
            "coordinateFrameId",
            "unit",
            "component",
            "baselineValue",
            "observedValue",
            "tolerance",
            "provenance"
          ],
          "properties": {
            "type": { "const": "point-component" },
            "id": { "$ref": "#/definitions/identifier" },
            "sensorId": { "$ref": "#/definitions/identifier" },
            "point": { "$ref": "#/definitions/point" },
            "coordinateFrameId": { "$ref": "#/definitions/identifier" },
            "unit": { "const": "mm/s" },
            "component": { "enum": ["x", "y"] },
            "baselineValue": { "$ref": "#/definitions/finiteNumber" },
            "observedValue": { "$ref": "#/definitions/finiteNumber" },
            "tolerance": { "$ref": "#/definitions/nonnegative" },
            "provenance": { "$ref": "#/definitions/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "sensorId",
            "point",
            "coordinateFrameId",
            "unit",
            "direction",
            "baselineValue",
            "observedValue",
            "tolerance",
            "provenance"
          ],
          "properties": {
            "type": { "const": "point-direction" },
            "id": { "$ref": "#/definitions/identifier" },
            "sensorId": { "$ref": "#/definitions/identifier" },
            "point": { "$ref": "#/definitions/point" },
            "coordinateFrameId": { "$ref": "#/definitions/identifier" },
            "unit": { "const": "mm/s" },
            "direction": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/definitions/finiteNumber" }
            },
            "baselineValue": { "$ref": "#/definitions/finiteNumber" },
            "observedValue": { "$ref": "#/definitions/finiteNumber" },
            "tolerance": { "$ref": "#/definitions/nonnegative" },
            "provenance": { "$ref": "#/definitions/text" }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "$ref": "#/definitions/nonnegative" },
        "unit": { "enum": ["mm/s", "1/s"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["velocityRms", "velocityGradientRms"],
      "properties": {
        "velocityRms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/budget" }
          ]
        },
        "velocityGradientRms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/budget" }
          ]
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "title", "point", "component", "unit"],
          "properties": {
            "type": { "const": "point-component" },
            "id": { "$ref": "#/definitions/identifier" },
            "title": { "$ref": "#/definitions/title" },
            "point": { "$ref": "#/definitions/point" },
            "component": { "enum": ["x", "y"] },
            "unit": { "const": "mm/s" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "title", "point", "direction", "unit"],
          "properties": {
            "type": { "const": "point-direction" },
            "id": { "$ref": "#/definitions/identifier" },
            "title": { "$ref": "#/definitions/title" },
            "point": { "$ref": "#/definitions/point" },
            "direction": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/definitions/finiteNumber" }
            },
            "unit": { "const": "mm/s" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title",
            "point",
            "unit",
            "directionCount"
          ],
          "properties": {
            "type": { "const": "point-speed-envelope" },
            "id": { "$ref": "#/definitions/identifier" },
            "title": { "$ref": "#/definitions/title" },
            "point": { "$ref": "#/definitions/point" },
            "unit": { "const": "mm/s" },
            "directionCount": {
              "type": "integer",
              "minimum": 3,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title",
            "cellIndices",
            "component",
            "unit"
          ],
          "properties": {
            "type": { "const": "region-component" },
            "id": { "$ref": "#/definitions/identifier" },
            "title": { "$ref": "#/definitions/title" },
            "cellIndices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": { "type": "integer", "minimum": 0 }
            },
            "component": { "enum": ["x", "y"] },
            "unit": { "const": "mm/s" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "title", "point", "component", "unit"],
          "properties": {
            "type": { "const": "point-strain-component" },
            "id": { "$ref": "#/definitions/identifier" },
            "title": { "$ref": "#/definitions/title" },
            "point": { "$ref": "#/definitions/point" },
            "component": { "enum": ["xx", "yy", "xy"] },
            "unit": { "const": "1/s" }
          }
        }
      ]
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rankRelativeTolerance",
        "basisConditionLimit",
        "verificationAbsoluteTolerance",
        "verificationRelativeTolerance",
        "maximumSolverIterations"
      ],
      "properties": {
        "rankRelativeTolerance": { "$ref": "#/definitions/positive" },
        "basisConditionLimit": { "$ref": "#/definitions/positive" },
        "verificationAbsoluteTolerance": {
          "$ref": "#/definitions/positive"
        },
        "verificationRelativeTolerance": {
          "$ref": "#/definitions/positive"
        },
        "maximumSolverIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "citation", "license", "transformations"],
      "properties": {
        "sourceKind": { "enum": ["generated", "declared"] },
        "citation": { "$ref": "#/definitions/text" },
        "license": { "$ref": "#/definitions/title" },
        "transformations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/definitions/text" }
        }
      }
    }
  }
}
