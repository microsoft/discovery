{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowblind.local/schemas/flowblind-catalog-research-v2-authority-unavailable.schema.json",
  "title": "FlowBlind catalog-native research v2 authority unavailable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "routerVersion",
    "status",
    "containsResults",
    "capability",
    "route",
    "releaseState",
    "authorityRequirementId",
    "requiredGrants",
    "authority",
    "reasonCodes",
    "guidance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "routerVersion": {
      "const": "2.0.0"
    },
    "status": {
      "const": "authority-unavailable"
    },
    "containsResults": {
      "const": false
    },
    "capability": {
      "type": "object"
    },
    "route": {
      "type": "object"
    },
    "releaseState": {
      "enum": [
        "candidate-active",
        "default-off",
        "trusted-private"
      ]
    },
    "authorityRequirementId": {
      "type": "string",
      "minLength": 1
    },
    "requiredGrants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "disabled-by-release-policy",
            "package-not-installed",
            "package-verification-failed",
            "retained-package-unavailable",
            "host-confirmation-authority-unavailable"
          ]
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guidance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
