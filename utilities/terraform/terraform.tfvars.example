# Copy to terraform.tfvars and edit before running `terraform apply`.
# Anything left commented out will fall back to the default in variables.tf.

resource_group_name = "rg-discovery-terraform"
location            = "uksouth"

# Optional Terraform-managed Workspace access; prefer an Entra group object ID.
# workspace_contributor_principal_ids = ["00000000-0000-0000-0000-000000000001"]

# All platform and managed infrastructure shares one region, defaulting to
# `location`. Discovery control-plane resources remain in `location`.
# managed_resource_group_location = null

# Default: explicit LoadBalancer mode; default outbound enabled on all subnets.
# No additional NAT Gateway or static egress IP is created.
# supercomputer_outbound_type = "LoadBalancer"
# management_subnet_prefix    = "10.0.7.0/28"

# UDR requires an existing reachable firewall/NVA, not a NAT Gateway public IP.
# Configure connectivity, forwarding, SNAT, DNS and required service allowlists
# before provisioning Discovery. No firewall or hub peering is created here.
# supercomputer_outbound_type   = "UserDefinedRouting"
# supercomputer_udr_next_hop_ip = "10.0.254.4"

# Tags can be applied globally and overridden per Discovery resource.
# common_tags = {
#   environment = "dev"
#   owner       = "discovery-team"
# }
# supercomputer_tags          = {}
# node_pool_tags              = {}
# workspace_tags              = {}
# chat_model_deployment_tags  = {}
# project_tags                = {}
# bookshelf_tags              = {}

# Optional: pin a fixed suffix so resource names are stable across runs.
# name_suffix = "dev01"

# Optional: override any auto-generated name.
# supercomputer_name         = "sc-discovery-dev"
# workspace_name             = "ws-discovery-dev"
# project_name               = "prj-discovery-dev"
# bookshelf_name             = "bs-discovery-dev"

# Workspace features (all default to true).
# network_isolation defaults to true. False omits the three workspace subnet
# IDs, but does not remove the shared VNet or private storage endpoint.
# network_isolation       = true
# enable_ghcp_ai_features = true
# enable_extensions       = true

# Optional Bookshelf. It reuses the private endpoint and search subnets plus
# the workload identity created by this configuration.
# enable_bookshelf                 = false
# bookshelf_public_network_access = "Disabled"

# Select a workload SKU and counts after checking service support and quota.
# The GPU default is not a cost recommendation; CPU SKUs can also be supplied.
# node_pool_vm_size            = "Standard_NC4as_T4_v3"
# node_pool_min_node_count     = 0
# node_pool_max_node_count     = 3
# node_pool_scale_set_priority = "Regular"

# Chat model (verify format + name are available in your region via the Discovery model catalog).
# chat_model_deployment_name = "gpt-5-2"
# chat_model_format          = "OpenAI"
# chat_model_name            = "gpt-5.2"
